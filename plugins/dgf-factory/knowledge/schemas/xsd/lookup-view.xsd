<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <!-- Root Element -->
    <xs:element name="view" type="lookupViewType"/>

    <!-- Main Lookup View Type -->
    <!-- Children in any order (XmlSerializer). Declared additions are only what the ComboBox mapping reads
         (ComboBoxComponentServiceInternal keeps the columns; TableDataQueryService reads the rest). -->
    <xs:complexType name="lookupViewType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="header" type="headerType"/>
            <xs:element name="description" type="descriptionType"/>
            <xs:element name="row" type="lookupRowType"/>
            <xs:element name="fetch" type="lookupFetchType"/>
            <xs:element name="handlers" type="lookupHandlersType"/>
            <!-- Columns fetched with each item but not shown. -->
            <xs:element name="hidden" type="lookupHiddenType"/>
            <!-- With mode="Hierarchy": a tree lookup. -->
            <xs:element name="parentFieldName" type="xs:string"/>
        </xs:choice>
        <xs:attribute name="select" type="xs:boolean"/>
        <xs:attribute name="preview" type="xs:boolean"/>
        <xs:attribute name="check" type="xs:boolean"/>
        <xs:attribute name="icon" type="xs:boolean"/>
        <xs:attribute name="mode" type="xs:string"/>
        <!-- As in table-view.xsd: how a paged ComboBox gets its total. -->
        <xs:attribute name="totalCount" default="separate">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="separate"/>
                    <xs:enumeration value="window"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="lookupHiddenType">
        <xs:sequence>
            <xs:element name="cell" type="lookupCellType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Header Type -->
    <xs:complexType name="headerType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="title" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Description Type -->
    <xs:complexType name="descriptionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="title" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Lookup Row Type -->
    <xs:complexType name="lookupRowType">
        <xs:sequence>
            <xs:element name="cell" type="lookupCellType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="keyfield" type="xs:string" use="required"/>
        <xs:attribute name="displayfield" type="xs:string"/>
    </xs:complexType>

    <!-- Lookup Cell Type -->
    <xs:complexType name="lookupCellType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="title" type="xs:string" use="required"/>
                <xs:attribute name="width" type="xs:integer"/>
                <xs:attribute name="hidden" type="xs:boolean"/>
                <xs:attribute name="reskey" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Lookup Fetch Type -->
    <xs:complexType name="lookupFetchType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="sort" type="lookupSortType"/>
            <xs:element name="filter" type="lookupFilterType"/>
            <xs:element name="groups" type="lookupGroupsType"/>
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="lookupGroupsType">
        <xs:sequence>
            <xs:element name="group" type="lookupGroupType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="lookupGroupType">
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="ascending" type="xs:boolean"/>
        <xs:attribute name="headerFormat" type="xs:string"/>
        <xs:attribute name="value" type="xs:string"/>
    </xs:complexType>

    <!-- Lookup Sort Type -->
    <xs:complexType name="lookupSortType">
        <xs:sequence>
            <xs:element name="column" type="sortColumnType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Sort Column Type -->
    <xs:complexType name="sortColumnType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="ascending" type="xs:boolean" use="required"/>
    </xs:complexType>

    <!-- Lookup Filter Type -->
    <xs:complexType name="lookupFilterType">
        <xs:sequence>
            <xs:element name="condition" type="lookupConditionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Lookup Condition Type -->
    <xs:complexType name="lookupConditionType">
        <xs:attribute name="attribute" type="xs:string" use="required"/>
        <xs:attribute name="operator" type="lookupOperatorType" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="value2" type="xs:string"/>
    </xs:complexType>

    <!-- Lookup Operator Type -->
    <xs:simpleType name="lookupOperatorType">
        <xs:restriction base="xs:string">
            <!-- Every operator FetchFilterConditionFormatter implements (same list as table-view.xsd). -->
            <xs:enumeration value="eq"/>
            <xs:enumeration value="eq_n"/>
            <xs:enumeration value="ne"/>
            <xs:enumeration value="not-null"/>
            <xs:enumeration value="null"/>
            <xs:enumeration value="contains"/>
            <xs:enumeration value="difference"/>
            <xs:enumeration value="like"/>
            <xs:enumeration value="not-like"/>
            <xs:enumeration value="gt"/>
            <xs:enumeration value="ge"/>
            <xs:enumeration value="lt"/>
            <xs:enumeration value="le"/>
            <xs:enumeration value="eq-userid"/>
            <xs:enumeration value="ne-userid"/>
            <xs:enumeration value="eq-appid"/>
            <xs:enumeration value="ne-appid"/>
            <xs:enumeration value="eq-teams"/>
            <xs:enumeration value="ne-teams"/>
            <xs:enumeration value="eq-role"/>
            <xs:enumeration value="on"/>
            <xs:enumeration value="after"/>
            <xs:enumeration value="before"/>
            <xs:enumeration value="on-or-after"/>
            <xs:enumeration value="on-or-before"/>
            <xs:enumeration value="after-and-before"/>
            <xs:enumeration value="today"/>
            <xs:enumeration value="future"/>
            <xs:enumeration value="past"/>
            <xs:enumeration value="future-or-today"/>
            <xs:enumeration value="past-or-today"/>
            <xs:enumeration value="next-seven-days"/>
            <xs:enumeration value="last-seven-days"/>
            <xs:enumeration value="eq-true"/>
            <xs:enumeration value="eq-false"/>
            <xs:enumeration value="empty"/>
            <xs:enumeration value="not-empty"/>
            <xs:enumeration value="in"/>
            <xs:enumeration value="not-in"/>
            <xs:enumeration value="eq-variable"/>
            <xs:enumeration value="ne-variable"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Lookup Handlers Type -->
    <xs:complexType name="lookupHandlersType">
        <xs:sequence>
            <xs:element name="property" type="lookupHandlerActionType" minOccurs="0"/>
            <xs:element name="create" type="lookupHandlerActionType" minOccurs="0"/>
            <xs:element name="view" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="view_ro" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Lookup Handler Action Type -->
    <xs:complexType name="lookupHandlerActionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="enabled" type="xs:boolean" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

</xs:schema>
