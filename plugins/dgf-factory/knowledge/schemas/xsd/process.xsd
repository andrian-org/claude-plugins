<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- Root Element -->
    <xs:element name="Process" type="ProcessType"/>

    <!-- Process Type Definition -->
    <xs:complexType name="ProcessType">
        <xs:sequence>
            <xs:element name="OnStart" type="OnStartType" minOccurs="1" maxOccurs="1"/>
            <xs:element name="States" type="StatesType" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
        <xs:attribute name="title" type="xs:string" use="required"/>
        <xs:attribute name="table" type="xs:string" use="required"/>
        <xs:attribute name="keyName" type="xs:string" use="required"/>
        <xs:attribute name="allowBack" type="xs:boolean" use="required"/>
        <xs:attribute name="allowHistory" type="xs:boolean" use="required"/>
        <xs:attribute name="allowAddSteps" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="allowAnonymouslyProcessing" type="xs:boolean" use="optional" default="false"/>
        <xs:attribute name="assignTasks" type="xs:boolean" use="required"/>
        <xs:attribute name="regardingType" type="xs:string" use="optional"/>
        <xs:attribute name="validationFlow" type="xs:string" use="optional"/>
    </xs:complexType>

    <!-- OnStart Type -->
    <xs:complexType name="OnStartType">
        <xs:sequence>
            <xs:element name="Transitions" type="TransitionsType" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
        <xs:attribute name="action" type="xs:string" use="required"/>
        <xs:attribute name="name" type="xs:string" use="optional"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
        <xs:attribute name="description" type="xs:string" use="optional"/>
    </xs:complexType>

    <!-- States Type -->
    <xs:complexType name="StatesType">
        <xs:sequence>
            <xs:element name="State" type="StateType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- State Type -->
    <xs:complexType name="StateType">
        <xs:sequence>
            <xs:element name="OnInit" type="OnInitType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="OnFinalize" type="OnFinalizeType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="Transitions" type="TransitionsType" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="StateTypeEnum" use="optional"/>
        <xs:attribute name="action" type="xs:string" use="optional"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
        <xs:attribute name="description" type="xs:string" use="optional"/>
        <xs:attribute name="internal" type="xs:boolean" use="optional" default="false"/>
    </xs:complexType>

    <!-- State Type Enumeration -->
    <xs:simpleType name="StateTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Task"/>
            <xs:enumeration value="SWITCH"/>
            <xs:enumeration value="SubProcess"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- OnInit Type -->
    <xs:complexType name="OnInitType">
        <xs:sequence>
            <xs:element name="UpdateRecord" type="UpdateRecordType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="Task" type="TaskType" minOccurs="0" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <!-- OnFinalize Type -->
    <xs:complexType name="OnFinalizeType">
        <xs:sequence>
            <xs:element name="Task" type="TaskType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="UpdateRecord" type="UpdateRecordType" minOccurs="0" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <!-- UpdateRecord Type -->
    <xs:complexType name="UpdateRecordType">
        <xs:sequence>
            <xs:element name="Assign" type="AssignType" minOccurs="0" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Assign Type -->
    <xs:complexType name="AssignType">
        <xs:sequence>
            <xs:element name="Field" type="FieldType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Field Type -->
    <xs:complexType name="FieldType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Task Type -->
    <xs:complexType name="TaskType">
        <xs:attribute name="state" type="TaskStateEnum" use="required"/>
        <xs:attribute name="role" type="xs:string" use="optional"/>
    </xs:complexType>

    <!-- Task State Enumeration -->
    <xs:simpleType name="TaskStateEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="NEW"/>
            <xs:enumeration value="COMPLETE"/>
            <xs:enumeration value="ASSIGNED"/>
            <xs:enumeration value="PENDING"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Transitions Type -->
    <xs:complexType name="TransitionsType">
        <xs:sequence>
            <xs:element name="Transition" type="TransitionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Transition Type -->
    <xs:complexType name="TransitionType">
        <xs:attribute name="state" type="xs:string" use="required"/>
        <xs:attribute name="color" type="xs:string" use="optional"/>
        <xs:attribute name="title" type="xs:string" use="optional"/>
        <xs:attribute name="action" type="xs:string" use="optional"/>
        <xs:attribute name="expression" type="xs:string" use="optional"/>
    </xs:complexType>

</xs:schema>
