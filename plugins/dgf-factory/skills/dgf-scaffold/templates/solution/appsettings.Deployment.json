{
  "WorkspaceName": "{{deployment.instance}}",
  "WebAppHost": "https://{{deployment.ref.ui_host}}",
  "ReverseProxyHost": "https://{{deployment.ref.api_host}}",
  "CorsOrigins": ["https://{{deployment.ref.ui_host}}"],
  "Authentication": {
{{#if deployment.has_basic}}
    "Basic": { "Enabled": true },
{{/if}}
{{#if deployment.has_dgpass}}
    "DGPassOIDC": {
      "Authority": "{{deployment.ref.dgpass_authority}}",
      "ClientId": "{{deployment.ref.dgpass_client_id}}",
      "ClientSecret": "{{deployment.ref.dgpass_client_secret}}"
    },
{{/if}}
{{#if deployment.has_azure}}
    "AzureOIDC": {
      "Authority": "{{deployment.ref.azure_authority}}",
      "TenantId": "{{deployment.ref.azure_tenant_id}}",
      "ClientId": "{{deployment.ref.azure_client_id}}",
      "ClientSecret": "{{deployment.ref.azure_client_secret}}"
    },
{{/if}}
    "SessionOptions": {
      "CookieNamePrefix": "{{deployment.cookie_prefix}}"
    }
  }
}
