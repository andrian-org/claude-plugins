{
  "ApplicationConfig": {
    "ApplicationName": "{{app.name}}"
  },
  "DatabaseProviderName": "Microsoft.Data.SqlClient",
  "WorkspacesRootPath": "/workspaces",
  "ConnectionStrings": {
    "LocalSqlServer": "${DB_CONNECTION_STRING}",
    "Redis": "${REDIS_CONNECTION}"
  },
  "DistributedCachingOptions": {
    "ServiceType": "DistributedCache",
    "UseRedisCache": true,
    "UseSqlServerCache": false,
    "RedisInstanceName": "{{app.name}}:",
    "RedisConnectionString": "${REDIS_CONNECTION}"
  },
  "Languages": ["en-US"],
  "Authentication": {
    "DefaultRole": "Members",
    "AutoApprove": true,
    "SessionOptions": {
      "CookieDomain": "${COOKIE_DOMAIN}",
      "UseDistributedCacheSessionStorage": true
    }
  },
{{#if any_basic}}
  "AdminSeedOptions": {
    "Enabled": true,
    "Accounts": [
      {
        "Username": "${ADMIN_USERNAME}",
        "Password": "${ADMIN_PASSWORD}",
        "Email": "${ADMIN_EMAIL}",
        "RoleName": "{{admin_role}}"
      }
    ]
  },
{{else}}
  "AdminSeedOptions": {
    "Enabled": false
  },
{{/if}}
  "Integrations": {
    "RegistrationAuthority": {
      "BaseUrl": "${RA_BASE_URL}",
      "AuthenticationScheme": "bearer",
      "TokenGeneration": {
        "CallingServiceFqn": "${RA_CALLING_SERVICE}",
        "CertificateThumbprint": "${RA_CERTIFICATE_THUMBPRINT}",
        "PrivateKey": "${RA_PRIVATE_KEY}"
      }
    },
    "DgSign": {
      "BaseUrl": "${SIGN_BASE_URL}",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": ["${SIGN_SERVICE}"], "Scopes": ["${SIGN_SCOPE}"] }
    },
    "DgNotify": {
      "BaseUrl": "${NOTIFY_BASE_URL}",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": ["${NOTIFY_SERVICE}"], "Scopes": ["${NOTIFY_SCOPE}"] },
      "Channels": "email",
      "SenderEmail": "${NOTIFY_SENDER_EMAIL}"
    },
    "DgNotifyOtp": {
      "BaseUrl": "${NOTIFY_BASE_URL}",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": ["${NOTIFY_SERVICE}"], "Scopes": ["${NOTIFY_SCOPE}"] }
    }
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "${SEQ_URL}" } }
    ]
  }
}
