{
  "manifest_format": 1,
  "entries": [
    {"template": "solution/App.slnx", "target": "{{app.name}}.slnx", "format": "xml"},
    {"template": "solution/Api.csproj", "target": "{{api.dir}}/{{api.project}}", "format": "msbuild", "repeat": ["api"]},
    {"template": "solution/Program.cs", "target": "{{api.dir}}/Program.cs", "format": "csharp", "repeat": ["api"]},
    {"template": "solution/appsettings.json", "target": "{{api.dir}}/appsettings.json", "format": "json", "repeat": ["api"]},
    {"template": "solution/appsettings.Deployment.json", "target": "{{api.dir}}/{{deployment.settings_file}}", "format": "json", "repeat": ["api", "deployment"]},
    {"template": "solution/Api.Dockerfile", "target": "{{api.dir}}/Dockerfile", "format": "docker", "repeat": ["api"]},
    {"template": "solution/Database.sqlproj", "target": "{{database.dir}}/{{database.project}}.sqlproj", "format": "msbuild"},
    {"template": "solution/Database.publish.xml", "target": "{{database.dir}}/{{database.project}}.publish.xml", "format": "msbuild"},
    {"template": "solution/Database.Dockerfile", "target": "{{database.dir}}/Dockerfile", "format": "docker"},
    {"template": "solution/entrypoint.sh", "target": "{{database.dir}}/entrypoint.sh", "format": "sh", "executable": true},
    {"template": "solution/Entity.sql", "target": "{{database.dir}}/dbo/Tables/{{entity.name}}.sql", "format": "sql", "repeat": ["entity"]},
    {"template": "solution/Script.PostDeployment.sql", "target": "{{database.dir}}/Scripts/Script.PostDeployment.sql", "format": "sql"},
    {"template": "solution/1.PostDeployment.Applications.sql", "target": "{{database.dir}}/ContinuousDeployment/1.PostDeployment.Applications.sql", "format": "sql"},
    {"template": "solution/2.PostDeployment.Roles.sql", "target": "{{database.dir}}/ContinuousDeployment/2.PostDeployment.Roles.sql", "format": "sql"},
    {"template": "solution/docker-compose.yml", "target": "docker/docker-compose.yml", "format": "yaml"},
    {"template": "solution/env.example", "target": "docker/.env.example", "format": "env"},
    {"template": "solution/traefik.dynamic.yml", "target": "docker/traefik/dynamic.yml", "format": "yaml"},
    {"template": "solution/README.md", "target": "docs/README.md", "format": "md"},
    {"template": "solution/architecture.md", "target": "docs/architecture.md", "format": "md"},
    {"template": "solution/data-model.md", "target": "docs/data-model.md", "format": "md"},
    {"template": "solution/configuration.md", "target": "docs/configuration.md", "format": "md"},
    {"template": "solution/gitignore", "target": ".gitignore", "format": "ignore"},
    {"template": "solution/gitattributes", "target": ".gitattributes", "format": "ignore"},
    {"template": "solution/dockerignore", "target": ".dockerignore", "format": "ignore"},
    {"template": "workspace/sitemap.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/sitemap.json", "format": "json", "repeat": ["workspace"]},
    {"template": "workspace/home.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/Page/SiteMap/home.json", "format": "json", "repeat": ["workspace"]},
    {"template": "workspace/loginPage.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/Page/SiteMap/loginPage.json", "format": "json", "repeat": ["workspace"]},
    {"template": "workspace/application.sitemap", "target": "workspaces/{{workspace.dir}}/_application.sitemap", "format": "xml", "repeat": ["workspace"]},
    {"template": "workspace/instance.sitemap", "target": "workspaces/{{workspace.dir}}/_application-{{instance.name}}.sitemap", "format": "xml", "repeat": ["workspace", "instance"], "when": ["shared-workspace"]},
    {"template": "workspace/tree.xml", "target": "workspaces/{{workspace.dir}}/FM/_PROFILE/Main/{{group.name}}/_tree.xml", "format": "xml", "repeat": ["workspace", "group"]},
    {"template": "workspace/node.xml", "target": "workspaces/{{workspace.dir}}/FM/_PROFILE/Main/{{membership.group.name}}/{{membership.module.name}}.xml", "format": "xml", "repeat": ["workspace", "membership"]},
    {"template": "patterns/page/content-page.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/Page/SiteMap/{{module.name}}.json", "format": "json", "repeat": ["workspace", "module"], "when": ["pattern:page"]},
    {"template": "patterns/register/entity-settings.xml", "target": "workspaces/{{workspace.dir}}/FM/_DATA/{{entity.name}}/settings.xml", "format": "xml", "repeat": ["workspace", "entity"]},
    {"template": "patterns/register/entity-form.xml", "target": "workspaces/{{workspace.dir}}/FM/_DATA/{{entity.name}}/_forms/default/_form.xml", "format": "xml", "repeat": ["workspace", "entity"]},
    {"template": "patterns/register/entity-lookup-view.xml", "target": "workspaces/{{workspace.dir}}/FM/_DATA/{{entity.name}}/_lookupviews/default/_view.xml", "format": "xml", "repeat": ["workspace", "entity"]},
    {"template": "patterns/register/table-view.xml", "target": "workspaces/{{workspace.dir}}/FM/_DATA/{{module.entity_obj.name}}/_views/default/_view.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:entity"]},
    {"template": "patterns/register/datasource.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/DataSource/{{module.entity_obj.name}}.json", "format": "json", "repeat": ["workspace", "module"], "when": ["pattern:entity"]},
    {"template": "patterns/register/list-page.json", "target": "workspaces/{{workspace.dir}}/FM/_COMPONENTS/Page/SiteMap/{{module.name}}.json", "format": "json", "repeat": ["workspace", "module"], "when": ["pattern:entity"]},
    {"template": "patterns/service/process.xml", "target": "workspaces/{{workspace.dir}}/FM/_PROCESS/{{module.name}}/process.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]},
    {"template": "patterns/service/workflow-draft.xml", "target": "workspaces/{{workspace.dir}}/FM/_WORKFLOW/{{module.name}}.Draft/_workflow.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]},
    {"template": "patterns/service/workflow-submitted.xml", "target": "workspaces/{{workspace.dir}}/FM/_WORKFLOW/{{module.name}}.Submitted/_workflow.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]},
    {"template": "patterns/service/workflow-inreview.xml", "target": "workspaces/{{workspace.dir}}/FM/_WORKFLOW/{{module.name}}.InReview/_workflow.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]},
    {"template": "patterns/service/workflow-approved.xml", "target": "workspaces/{{workspace.dir}}/FM/_WORKFLOW/{{module.name}}.Approved/_workflow.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]},
    {"template": "patterns/service/workflow-rejected.xml", "target": "workspaces/{{workspace.dir}}/FM/_WORKFLOW/{{module.name}}.Rejected/_workflow.xml", "format": "xml", "repeat": ["workspace", "module"], "when": ["pattern:service"]}
  ]
}
