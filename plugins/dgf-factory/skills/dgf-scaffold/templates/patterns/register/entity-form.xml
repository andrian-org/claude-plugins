<?xml version="1.0" encoding="utf-8"?>
<form labelwidth="160">
  <header title="default" />
  <description title="" />
  <tabs>
    <tab title="{{entity.title}}" name="tab_main">
      <sections>
        <section name="sec_main" title="{{entity.title}}" showlabel="false" decoration="line" columns="1">
          <rows>
{{#each entity.fields}}
{{#if !is_key}}
            <row>
              <cell title="{{title}}" name="{{name}}" />
            </row>
{{/if}}
{{/each}}
          </rows>
        </section>
      </sections>
    </tab>
  </tabs>
{{#if entity.has_application_id}}
  <hidden>
    <cell name="ApplicationId" title="ApplicationId">
      <properties oncreatevalue="~APPLICATIONID" />
    </cell>
  </hidden>
{{else}}
  <hidden />
{{/if}}
</form>
