<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <!-- Root Element -->
    <xs:element name="view" type="gridViewType"/>

    <!-- Main Grid View Type -->
    <!-- Children in any order (XmlSerializer). Declared additions are only what the DataTable editable-grid
         mapping reads (DataTableComponentServiceInternal → MapFromDataGrid, loaded as EditableGridView). -->
    <xs:complexType name="gridViewType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="row" type="gridRowType"/>
            <xs:element name="header" type="headerType"/>
            <xs:element name="description" type="descriptionType"/>
            <xs:element name="fetch" type="gridFetchType"/>
            <xs:element name="handlers" type="gridHandlersType"/>
            <xs:element name="autoNewRow" type="xs:string"/>
            <xs:element name="totalField" type="xs:string"/>
            <!-- Columns fetched with each row but not shown. -->
            <xs:element name="hidden" type="gridHiddenType"/>
            <xs:element name="hideHeaders" type="xs:string"/>
            <!-- A CSS style for rows matching ANY of its conditions. -->
            <xs:element name="rowstyle" type="g_rowStyleListType"/>
        </xs:choice>
        <xs:attribute name="ordernumber" type="xs:boolean"/>
        <!-- Row multi-select. -->
        <xs:attribute name="check" type="xs:boolean"/>
    </xs:complexType>

    <xs:complexType name="gridHiddenType">
        <xs:sequence>
            <xs:element name="cell" type="gridCellType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Header Type -->
    <xs:complexType name="headerType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="title" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Description Type -->
    <xs:complexType name="descriptionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="title" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Grid Row Type -->
    <xs:complexType name="gridRowType">
        <xs:sequence>
            <xs:element name="cell" type="gridCellType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Grid Cell Type -->
    <xs:complexType name="gridCellType">
        <xs:sequence>
            <xs:element name="properties" type="gridPropertiesType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="title" type="xs:string" use="required"/>
        <xs:attribute name="width" type="xs:integer"/>
        <xs:attribute name="align" type="alignType"/>
        <!-- A JSON component in FM/_COMPONENTS/Template/<name>.json (BASE: → base workspace), rendered in every
             row of this column with the row as ${item.*}. -->
        <xs:attribute name="columnTemplate" type="xs:string"/>
        <xs:attribute name="hidden" type="xs:boolean"/>
        <xs:attribute name="reskey" type="xs:string"/>
    </xs:complexType>

    <!-- Alignment Type -->
    <xs:simpleType name="alignType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="left"/>
            <xs:enumeration value="center"/>
            <xs:enumeration value="right"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Grid Properties Type -->
    <xs:complexType name="gridPropertiesType">
        <xs:attribute name="readonly" type="readonlyType"/>
        <xs:attribute name="requiredlevel" type="requiredLevelType"/>
        <xs:attribute name="handlermode" type="handlerModeType"/>
        <xs:attribute name="oncreatevalue" type="xs:string"/>
        <xs:attribute name="onupdatevalue" type="xs:string"/>
    </xs:complexType>

    <!-- Readonly Type -->
    <xs:simpleType name="readonlyType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="true"/>
            <xs:enumeration value="false"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Required Level Type -->
    <xs:simpleType name="requiredLevelType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="required"/>
            <xs:enumeration value="recommended"/>
            <xs:enumeration value="optional"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Handler Mode Type -->
    <xs:simpleType name="handlerModeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="editable"/>
            <xs:enumeration value="readonly"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Grid Fetch Type -->
    <xs:complexType name="gridFetchType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="sort" type="gridSortType"/>
            <xs:element name="filter" type="gridFilterType"/>
            <!-- A grouped grid. -->
            <xs:element name="groups" type="g_groupsType"/>
        </xs:choice>
    </xs:complexType>

    <!-- Grid Sort Type -->
    <xs:complexType name="gridSortType">
        <xs:sequence>
            <xs:element name="column" type="sortColumnType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Sort Column Type -->
    <xs:complexType name="sortColumnType">
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="ascending" type="xs:boolean" use="required"/>
    </xs:complexType>

    <!-- Grid Filter Type -->
    <xs:complexType name="gridFilterType">
        <xs:sequence>
            <xs:element name="condition" type="filterConditionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Filter Condition Type -->
    <xs:complexType name="filterConditionType">
        <xs:attribute name="attribute" type="xs:string" use="required"/>
        <xs:attribute name="operator" type="xs:string"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="value2" type="xs:string"/>
    </xs:complexType>

    <!-- Grid Handlers Type -->
    <xs:complexType name="gridHandlersType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="smartedit" type="handlerActionType"/>
            <xs:element name="create" type="gridHandlerActionType"/>
            <xs:element name="select" type="gridHandlerActionType"/>
            <xs:element name="select_ro" type="gridHandlerActionType"/>
            <xs:element name="delete" type="handlerActionType"/>
            <xs:element name="edit" type="gridHandlerActionType"/>
        </xs:choice>
    </xs:complexType>

    <!-- Handler Action Type (for smartedit, delete) -->
    <xs:complexType name="handlerActionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="enabled" type="xs:boolean" use="required"/>
                <xs:attribute name="title" type="xs:string"/>
                <xs:attribute name="reskey" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Grid Handler Action Type (for create, select, select_ro, edit) -->
    <xs:complexType name="gridHandlerActionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="enabled" type="xs:boolean" use="required"/>
                <xs:attribute name="title" type="xs:string"/>
                <xs:attribute name="window" type="xs:string"/>
                <xs:attribute name="reskey" type="xs:string"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- Shapes shared with table-view.xsd. -->
    <xs:complexType name="g_groupsType">
        <xs:sequence>
            <xs:element name="group" type="g_groupType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="g_groupType">
        <xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="ascending" type="xs:boolean"/>
        <xs:attribute name="groupDisplayType" type="xs:string"/>
        <xs:attribute name="headerFormat" type="xs:string"/>
        <xs:attribute name="value" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="g_rowStyleListType">
        <xs:sequence>
            <xs:element name="style" type="g_rowStyleType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="g_rowStyleType">
        <xs:sequence>
            <xs:element name="condition" type="filterConditionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="valueNew" type="xs:string"/>
    </xs:complexType>

</xs:schema>
