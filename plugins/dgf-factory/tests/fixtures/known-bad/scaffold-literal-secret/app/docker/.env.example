# Inspections — the values the local stack needs. Copy this file to .env and fill it in; .env is git-ignored.
# Every variable is described in docs/configuration.md. A secret has no example value on purpose.

# Local stack — The SQL Server `sa` password of the local stack.
MSSQL_SA_PASSWORD=

# Local stack — The database the stack creates and publishes into.
MSSQL_DB=Inspections

# Local stack — The host port SQL Server listens on.
MSSQL_PORT=1433

# Local stack — The SQL connection string of the API hosts, for example Data Source=sqlserver;Initial Catalog=<MSSQL_DB>;User ID=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True;
DB_CONNECTION_STRING=

# Local stack — The Redis endpoint of the API hosts' cache.
REDIS_CONNECTION=redis:6379

# Local stack — The Seq log server the hosts write to.
SEQ_URL=http://seq

# Images and feeds — An image that publishes the framework's database baseline into the stack's database. DGF pins none: build one from the framework's database project.
DGF_DB_INIT_IMAGE=

# Images and feeds — The DGF UI image, served by nginx. DGF pins no tag: build one from the framework's UI source.
DGF_UI_IMAGE=

# Images and feeds — The NuGet source that serves the DGF.API package.
NUGET_FEED_URL=

# Images and feeds — The access token for that feed.
NUGET_FEED_TOKEN=

# Local stack — A directory holding cert.pem and key.pem for the hosts below. The host sets its cookies secure-only, so the stack must serve HTTPS.
TLS_CERT_DIR=./certs

# Local stack — The domain the session cookies are set on.
COOKIE_DOMAIN=.localtest.me

# Integrations — The Registration Authority every DGF integration authenticates through.
RA_BASE_URL=

# Integrations — The calling service name presented to the Registration Authority.
RA_CALLING_SERVICE=

# Integrations — The thumbprint of the certificate registered for this service.
RA_CERTIFICATE_THUMBPRINT=

# Integrations — The private key that signs the token request.
RA_PRIVATE_KEY=

# Integrations — The signing service.
SIGN_BASE_URL=

# Integrations — The service name the signing scope belongs to.
SIGN_SERVICE=

# Integrations — The scope requested for signing.
SIGN_SCOPE=

# Integrations — The notification service.
NOTIFY_BASE_URL=

# Integrations — The service name the notification scope belongs to.
NOTIFY_SERVICE=

# Integrations — The scope requested for notification.
NOTIFY_SCOPE=

# Integrations — The sender address of the notifications the hosts send.
NOTIFY_SENDER_EMAIL=

# Sign-in — The user name of the first administrator, seeded at first start.
ADMIN_USERNAME=admin

# Sign-in — The password of the first administrator.
ADMIN_PASSWORD=

# Sign-in — The e-mail address of the first administrator.
ADMIN_EMAIL=

# Images and feeds — The absolute path of the base workspace directory, named webasm.
DGF_BASE_WORKSPACE=

# Deployment Api / Web — The host name the Web UI is served on.
API_WEB_UI_HOST=

# Deployment Api / Web — The host name the Web API is served on.
API_WEB_API_HOST=
