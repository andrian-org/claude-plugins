{
  "comment": "Which DGF line setup installs (ADR 0036 §3). Read by tests/test_dgf_version.py and tests/cli/lines.test.mjs; both implementations must pass every case.",
  "lines": ["1.1", "1.2", "1.3"],
  "current": "1.3",
  "cases": [
    {"name": "registered --dgf-line", "input": {"flag_line": "1.2"}, "expect": {"line": "1.2", "source": "flag-line"}},
    {"name": "unregistered --dgf-line", "input": {"flag_line": "9.9"}, "expect": {"error": "usage"}},
    {"name": "malformed --dgf-line", "input": {"flag_line": "1.x"}, "expect": {"error": "usage"}},
    {"name": "both flags", "input": {"flag_line": "1.2", "flag_version": "1.2.0"}, "expect": {"error": "usage"}},
    {"name": "--dgf-version on a line", "input": {"flag_version": "1.2.0"}, "expect": {"line": "1.2", "source": "flag-version"}},
    {"name": "--dgf-version patch on a line", "input": {"flag_version": "1.3.7"}, "expect": {"line": "1.3", "source": "flag-version"}},
    {"name": "--dgf-version above every line", "input": {"flag_version": "1.4.2"}, "expect": {"line": "1.3", "source": "flag-version", "note": true}},
    {"name": "--dgf-version below every line", "input": {"flag_version": "1.0.9"}, "expect": {"error": "blocked"}},
    {"name": "--dgf-version malformed", "input": {"flag_version": "1.x"}, "expect": {"error": "usage"}},
    {"name": "--dgf-version wins over receipt and config", "input": {"flag_version": "1.1.16", "receipt_line": "1.3", "config_version": "1.3.0"}, "expect": {"line": "1.1", "source": "flag-version"}},
    {"name": "receipt wins over config", "input": {"receipt_line": "1.2", "config_version": "1.3.0"}, "expect": {"line": "1.2", "source": "receipt"}},
    {"name": "unregistered receipt line falls through to config", "input": {"receipt_line": "1.0", "config_version": "1.2.0"}, "expect": {"line": "1.2", "source": "config"}},
    {"name": "config version", "input": {"config_version": "1.2.0"}, "expect": {"line": "1.2", "source": "config"}},
    {"name": "config version below every line", "input": {"config_version": "1.0.33"}, "expect": {"error": "blocked"}},
    {"name": "config unknown", "input": {"config_version": "unknown"}, "expect": {"line": "1.3", "source": "current", "note": true}},
    {"name": "config absent", "input": {}, "expect": {"line": "1.3", "source": "current", "note": true}},
    {"name": "config not a version", "input": {"config_version": "latest"}, "expect": {"line": "1.3", "source": "current", "note": true}}
  ],
  "gap": {
    "comment": "A line with no pack between two that have one maps to the nearest older pack.",
    "lines": ["1.1", "1.3"],
    "current": "1.3",
    "input": {"flag_version": "1.2.0"},
    "expect": {"line": "1.1", "source": "flag-version", "note": true}
  }
}
