{
  "WorkspaceName": "deeds",
  "WebAppHost": "https://${PUBLICAPI_DEEDSPUBLIC_UI_HOST}",
  "ReverseProxyHost": "https://${PUBLICAPI_DEEDSPUBLIC_API_HOST}",
  "CorsOrigins": ["https://${PUBLICAPI_DEEDSPUBLIC_UI_HOST}"],
  "Authentication": {
    "DGPassOIDC": {
      "Authority": "${PUBLICAPI_DEEDSPUBLIC_DGPASS_AUTHORITY}",
      "ClientId": "${PUBLICAPI_DEEDSPUBLIC_DGPASS_CLIENT_ID}",
      "ClientSecret": "${PUBLICAPI_DEEDSPUBLIC_DGPASS_CLIENT_SECRET}"
    },
    "SessionOptions": {
      "CookieNamePrefix": "deedspublic"
    }
  }
}
