{
  "WorkspaceName": "lands",
  "WebAppHost": "https://${PUBLICAPI_LANDSPUBLIC_UI_HOST}",
  "ReverseProxyHost": "https://${PUBLICAPI_LANDSPUBLIC_API_HOST}",
  "CorsOrigins": ["https://${PUBLICAPI_LANDSPUBLIC_UI_HOST}"],
  "Authentication": {
    "DGPassOIDC": {
      "Authority": "${PUBLICAPI_LANDSPUBLIC_DGPASS_AUTHORITY}",
      "ClientId": "${PUBLICAPI_LANDSPUBLIC_DGPASS_CLIENT_ID}",
      "ClientSecret": "${PUBLICAPI_LANDSPUBLIC_DGPASS_CLIENT_SECRET}"
    },
    "SessionOptions": {
      "CookieNamePrefix": "landspublic"
    }
  }
}
