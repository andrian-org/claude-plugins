{
  "WorkspaceName": "lands",
  "WebAppHost": "https://${STAFFAPI_LANDSSTAFF_UI_HOST}",
  "ReverseProxyHost": "https://${STAFFAPI_LANDSSTAFF_API_HOST}",
  "CorsOrigins": ["https://${STAFFAPI_LANDSSTAFF_UI_HOST}"],
  "Authentication": {
    "Basic": { "Enabled": true },
    "AzureOIDC": {
      "Authority": "${STAFFAPI_LANDSSTAFF_AZURE_AUTHORITY}",
      "TenantId": "${STAFFAPI_LANDSSTAFF_AZURE_TENANT_ID}",
      "ClientId": "${STAFFAPI_LANDSSTAFF_AZURE_CLIENT_ID}",
      "ClientSecret": "${STAFFAPI_LANDSSTAFF_AZURE_CLIENT_SECRET}"
    },
    "SessionOptions": {
      "CookieNamePrefix": "landsstaff"
    }
  }
}
