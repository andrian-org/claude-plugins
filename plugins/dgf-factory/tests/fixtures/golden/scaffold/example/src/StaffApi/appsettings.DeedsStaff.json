{
  "WorkspaceName": "deeds",
  "WebAppHost": "https://${STAFFAPI_DEEDSSTAFF_UI_HOST}",
  "ReverseProxyHost": "https://${STAFFAPI_DEEDSSTAFF_API_HOST}",
  "CorsOrigins": ["https://${STAFFAPI_DEEDSSTAFF_UI_HOST}"],
  "Authentication": {
    "Basic": { "Enabled": true },
    "AzureOIDC": {
      "Authority": "${STAFFAPI_DEEDSSTAFF_AZURE_AUTHORITY}",
      "TenantId": "${STAFFAPI_DEEDSSTAFF_AZURE_TENANT_ID}",
      "ClientId": "${STAFFAPI_DEEDSSTAFF_AZURE_CLIENT_ID}",
      "ClientSecret": "${STAFFAPI_DEEDSSTAFF_AZURE_CLIENT_SECRET}"
    },
    "SessionOptions": {
      "CookieNamePrefix": "deedsstaff"
    }
  }
}
