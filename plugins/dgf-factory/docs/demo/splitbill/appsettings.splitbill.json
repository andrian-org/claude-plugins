{
  // ---------------------------------------------------------------------------
  // DEFAULT STACK CONFIGURATION — framework showcase (`dgf` workspace).
  //
  // This file REPLACES samples/BFF.API/appsettings.json inside the container. It does not layer
  // on top of it. That is deliberate: the BFF.API file is a ZamOffice tenant configuration
  // carrying live endpoints and credentials, and layering a Development overlay over it would
  // leave all of that underneath as the base layer.
  //
  // NO CREDENTIAL BELONGS IN THIS FILE. Connection strings, the SA password and the seeded admin
  // password all arrive as environment variables from docker-compose.yml / .env, so this file
  // stays safe to commit and a grep for `Password` over configs/default/ stays empty.
  // ---------------------------------------------------------------------------

  "application-version": "0.0.0-local",

  "ApplicationConfig": {
    "ApplicationName": "DGF",
    // Empty on purpose: the showcase must run with no tenant plugin assemblies (plan §3.4).
    "CustomAssembliesPath": ""
  },

  // Set from compose: WorkspaceName / WorkspacesRootPath / DGF_WORKSPACES_ROOT_PATH.
  "WorkspaceName": "splitbill",
  "WorkspacesRootPath": "/workspaces",

  "DatabaseProviderName": "Microsoft.Data.SqlClient",

  // ConnectionStrings:LocalSqlServer and :Redis come from the environment — see docker-compose.yml.
  "DistributedCachingOptions": {
    "ServiceType": "DistributedCache",
    "UseRedisCache": true,
    "UseSqlServerCache": false,
    "RedisInstanceName": "SPLITBILL:",
    "SlidingExpirationTimeSpan": "10:00:00"
  },

  // Westwind.Globalization, wired up unconditionally by DGF.Kernel/KernelExtensions.cs:29.
  // ResourceTableName MUST be set: Westwind's own default is "Localizations", a table that exists
  // in no DGF or consumer database, so leaving it unset makes every DB-backed lookup miss.
  // ConnectionString comes from the environment (DbResourceConfiguration__ConnectionString).
  "DbResourceConfiguration": {
    "DataProvider": "SqlServer",
    "ResourceTableName": "AX_Localizations",
    "ResourceAccessMode": "DbResourceManager",
    "AddMissingResources": false
  },

  "WebAppHost": "https://splitbill.localtest.me",
  "ReverseProxyHost": "https://splitbill-api.localtest.me",
  // `dgfui*` are the hostnames the existing Playwright suite in tests/ already targets. The
  // default stack answers on both names so that suite needs no edits — see docker-compose.yml.
  "CorsOrigins": [
    "https://splitbill.localtest.me",
    "https://splitbill-api.localtest.me"
  ],

  "Languages": [ "en-US" ],

  "Authentication": {
    // Local username/password only. No DGPass / OIDC block: it needs a client secret and a
    // reachable identity provider, and the showcase must start with neither.
    "Basic": { "Enabled": true },
    "DefaultRole": "Applicant",
    "AutoApprove": true,
    "UiCookieDomain": "splitbill-api.localtest.me",
    "SessionOptions": {
      "CookieDomain": "splitbill-api.localtest.me",
      "CookieNamePrefix": "splitbill",
      "IdleTimeout": "04:30:00",
      "SlidingExpiration": true,
      "SameSite": "Lax",
      "UseDistributedCacheSessionStorage": true
    }
  },

  // Accounts are supplied by compose as AdminSeedOptions__Accounts__0__* so no password is
  // committed here. ApplicationDbContextSeed skips seeding entirely when Enabled is false.
  "AdminSeedOptions": { "Enabled": true },

  "RoleSwitcher": { "Enabled": true },
  "TeamSwitcher": { "Enabled": true },
  "CorporateAccount": { "Enabled": false },

  // OSS document pipeline. Syncfusion is the compile-time default (DocumentsOptions), but it needs
  // a commercial licence key we will not ship, so the default stack selects the OpenXml engine and
  // the Gotenberg converter from docker-compose.shared.yml.
  "Documents": {
    "Engine": "OpenXml",
    "PdfConverter": "Gotenberg",
    "GotenbergUrl": "http://gotenberg:3000"
  },

  "ProcessConfigurations": {
    "InitValidationFlow": "BASE:EDefaultProcessValidation"
  },

  "TemplateRendering": { "UnresolvedCellDisplayValue": "-" },

  // Component-level defaults, overridable per component instance.
  //
  // The section name is `Defaults`, NOT the component name at the root. DGF.Uploader and
  // DGF.ImageComponent both bind `Defaults:<Name>`
  // (DGF.Uploader/ConfigureServices.cs:18, DGF.ImageComponent/ConfigureServices.cs:13-14), so a
  // root-level "Uploader" block - which is what the tenant configs carry, and what this file
  // carried until P5 - binds to nothing at all and is silently ignored.
  //
  // Only the properties below exist. The tenant configs also set AllowedTypes, IgnorePdfConvert
  // and MaxSizeB; none of those three appears anywhere in the C# and all three are inert.
  // Note that the real size property is MaxFileSize, not MaxSizeB.
  "Defaults": {
    "Uploader": {
      "AllowedExtensions": ".pdf,.png,.jpg,.jpeg",
      "MaxFileSize": 4096000,
      "MinFileSize": 1,
      "Multiple": true,
      "AllowDelete": true
    },
    "ImageUpload": {
      "AllowedExtensions": ".jpeg,.png,.jpg,.heic",
      "MaxFileSize": 5012000
    }
  },

  "workflow": { "EnableMetrics": true },
  "Plugins": { "UserTrackerOptions": { "Enabled": true } },

  // ---------------------------------------------------------------------------------------
  // PLATFORM SERVICES -> local WireMock stubs (docker-compose.stubs.yml, mappings under stubs/).
  //
  // Two separate reasons these sections are here.
  //
  // (1) They must EXIST at all, even for the parts of the showcase that never call them.
  //     DGF.Sign/DiExtensions.cs and DGF.Notify/Extensions/DiExtensions.cs register SignService
  //     and IEmailService only `if (config.GetSection("Integrations:<X>").Exists())`, but
  //     PdfViewerComponentService and PasswordRecoveryService take them as plain constructor
  //     dependencies and are registered unconditionally. With the sections omitted,
  //     ValidateOnBuild fails and the API exits before serving a request:
  //
  //       Unable to resolve service for type 'DGF.Kernel.Notifications.IEmailService'
  //         while attempting to activate 'PasswordRecoveryService'
  //       Unable to resolve service for type 'DGF.Sign.SignService'
  //         while attempting to activate 'PdfViewerComponentService'
  //
  //     That is a framework defect - an unconditional consumer of a conditionally-registered
  //     service - and it is invisible to every tenant, because every tenant config declares these
  //     sections. The real fix belongs in DI, not here.
  //
  // (2) They point at the stubs so the Tier-C examples actually WORK. DgPay, DgSign, DgNotify and
  //     DgNotifyOtp are all registered as RaAuthEndpoint<T>, and RaAuthEndpoint.SendAsync obtains
  //     a Registration Authority token before every request - so `RegistrationAuthority` below is
  //     not optional for any of them. Only PinCodeSign is a plain REST endpoint.
  //
  // The :8080 on every stub BaseUrl is WireMock's own listen port. Container-to-container traffic
  // goes straight to it and does NOT pass through traefik, so the port cannot be omitted the way it
  // can in the https://dgf-stub-*.localtest.me browser URLs. Getting this wrong surfaces as
  // "Connection refused (dgf-stub-ra:80)" inside a payment, not as a startup failure.
  //
  // Still no credential in this file: the one secret-shaped value, the RA signing key, arrives as
  // Integrations__RegistrationAuthority__TokenGeneration__PrivateKey from .env, generated per
  // machine by up.sh / up.ps1. See stubs/README.md.
  // ---------------------------------------------------------------------------------------
  "Integrations": {

    "RegistrationAuthority": {
      "BaseUrl": "http://dgf-stub-ra:8080",
      "AuthenticationScheme": "bearer",
      "TokenGeneration": {
        "CallingServiceFqn": "dgf.local.showcase",
        // Not a real thumbprint. dgf-stub-ra echoes a fixed token and inspects nothing, so this
        // only has to be non-empty - TokenGeneration.ThrowIfInvalid rejects a blank one.
        "CertificateThumbprint": "0000000000000000000000000000000000000000"
        // PrivateKey: from the environment. Never committed.
      }
    },

    "DgPay": {
      "BaseUrl": "http://dgf-stub-pay:8080",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": [ "dgf.local.pay" ], "Scopes": [ "pay", "pay-cash" ] },
      // Paths mirror the real gateway's tenant-scoped shape with `dgf` as the tenant, so moving to
      // a real DgPay is a change of BaseUrl and tenant segment, not of client code.
      "CreateInvoiceUri": "/t/dgf/pay/invoice/create?scope=pay",
      "CancelInvoiceUri": "/t/dgf/pay/invoice/cancel?scope=pay",
      "PaymentCashUri": "/t/dgf/pay/transaction/cash?scope=pay-cash",
      "GetInvoiceUriTemplate": "/t/dgf/pay/invoice?invoiceNumber={0}",
      "GetPaymentStatusUriTemplate": "/t/dgf/pay/status?invoiceNumber={0}",
      "GetReceiptUriTemplate": "/t/dgf/pay/receipt?invoiceNumber={0}",
      "GetPaymentByInvoiceNumberUriTemplate": "/payments/{0}",
      "DownloadInvoiceUriTemplate": "/pdf?invoiceNumber={0}&documentType=invoice",
      "DownloadReceiptUriTemplate": "/pdf?invoiceNumber={0}&documentType=receipt",
      // EMPTY ON PURPOSE, and it is the only value here that is not simply "point at the stub".
      // DgPayEndpointOptions.DownloadInvoiceUri prefixes PdfServiceBaseUrl, producing an ABSOLUTE
      // url; PaymentService.DownloadPdf hands that to RestEndpoint.GetAsync, which does
      // `new Uri(uri, UriKind.Relative)` and throws UriFormatException on anything absolute. So
      // DownloadPdf is broken for every tenant that sets this - see tasks/todo.md, P5 findings.
      // Left empty here, the url stays relative to BaseUrl and the download works.
      "PdfServiceBaseUrl": "",
      // Where the Pay button sends the citizen. The stub serves a small portal page whose "Pay
      // now" button advances its own invoice-lifecycle scenario to Paid, so the round trip
      // completes in a browser - see stubs/pay/__files/portal.html.
      "PayPortalRedirectUrlTemplate": "https://dgf-stub-pay.localtest.me/portal?invoiceNumber={0}",
      "ServiceProviderName": "DGF Demo Authority",
      "ServiceProviderCode": "DGF",
      "ClientServiceName": "Demo permit",
      "ClientServiceCode": "DGF-DEMO"
    },

    "DgSign": {
      "BaseUrl": "http://dgf-stub-sign:8080",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": [ "dgf.local.sign" ], "Scopes": [ "sign" ] }
    },

    // The one integration that is NOT RA-authenticated (DGF.Sign/DiExtensions.cs:18 registers it
    // with RegisterRestEndpoint), so it reaches its stub without a token.
    "PinCodeSign": { "BaseUrl": "http://dgf-stub-sign:8080" },

    "DgNotify": {
      "BaseUrl": "http://dgf-stub-notify:8080",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": [ "dgf.local.notify" ], "Scopes": [ "notify" ] },
      "Channels": "email",
      "SenderEmail": "noreply@localtest.me"
    },

    "DgNotifyOtp": {
      "BaseUrl": "http://dgf-stub-notify:8080",
      "AuthenticationScheme": "RA",
      "ApplicationScopes": { "Services": [ "dgf.local.notify" ], "Scopes": [ "notify" ] }
    }
  },

  // Deliberately absent, and each for a reason:
  //   Integrations:NIR / ZamConnect - tenant service accounts with passwords.
  //   PowerBi       - requires a real tenant and an embed token; nothing meaningful to stub (D4).
  //   Endpoints     - the `zamconnect` endpoint carries a service account password.
  //   userRequirements - tenant-specific registration gates that would block local login.
  //   SyncfusionLicense - commercial key; see Documents above.

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq" } }
    ]
  }
}
